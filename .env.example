# AI 运势预测 - 环境变量配置示例
# 复制这个文件为 .env，然后填入你的配置

# ========== API 配置 ==========
# DeepSeek API Key（推荐）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 或者 OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# ========== 模型配置 ==========
# 使用的模型名称
FORTUNE_MODEL=deepseek-chat

# API 地址
FORTUNE_BASE_URL=https://api.deepseek.com

# 温度参数（0-2），越大越有创造力
FORTUNE_TEMPERATURE=0.7

# 最大输出 token 数
FORTUNE_MAX_TOKENS=2048

# 超时时间（秒）
FORTUNE_TIMEOUT=30

# ========== 功能开关 ==========
# 流式输出
FEATURE_STREAM=true

# 分享图片功能
FEATURE_SHARE=true

# 历史记录功能
FEATURE_HISTORY=true

# 用户认证（默认关闭）
FEATURE_AUTH=false

# 内容审核
FEATURE_MODERATION=true

# ========== 缓存配置 ==========
# 是否启用缓存
CACHE_ENABLED=true

# 缓存过期时间（秒）
CACHE_TTL=3600

# 最大缓存条目数
CACHE_MAX_SIZE=1000

# ========== 限流配置 ==========
# 每分钟最大请求数
RATE_LIMIT_PER_MINUTE=30

# 每个用户每天最大请求数
RATE_LIMIT_PER_USER_DAY=50

# ========== 内容安全 ==========
# 最大输出长度
SAFETY_MAX_OUTPUT=5000

# 最小输出长度
SAFETY_MIN_OUTPUT=100
